{
  "name": "ink-on-hex",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "maker": "vite --open /maker.html",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "bun test src",
    "test:e2e": "playwright test",
    "test:hooks": "bun test ./.claude/hooks",
    "typecheck": "tsc -b && tsc --noEmit -p .claude/hooks",
    "lint": "oxlint --report-unused-disable-directives-severity=warn && stylelint \"src/**/*.scss\"",
    "format": "prettier --write . && textlint --fix \"**/*.md\""
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "5.3.0",
    "@gsap/react": "^2.1.2",
    "gsap": "3.13.0",
    "jotai": "^3.0.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "0.179.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@storybook/react-vite": "10.6.8",
    "@types/bun": "^1.4.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "0.179.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.95.0",
    "postcss-scss": "^4.0.9",
    "prettier": "^3.10.1",
    "sass-embedded": "^1.108.2",
    "storybook": "10.6.8",
    "stylelint": "^18.1.0",
    "stylelint-config-recess-order": "^7.10.1",
    "stylelint-config-standard-scss": "^18.0.0",
    "stylelint-order": "^8.1.3",
    "stylelint-scss": "^7.5.0",
    "textlint": "^15.7.1",
    "textlint-rule-preset-jtf-style": "^3.0.3",
    "typescript": "~7.0.2",
    "vite": "^8.3.6"
  }
}
